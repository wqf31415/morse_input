<?xml version="1.0" encoding="utf-8"?>
<!-- 键盘布局 -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="25%p"
    android:keyHeight="56dp"
    android:horizontalGap="1dp"
    android:verticalGap="1dp">

    <Row>
        <Key android:keyLabel="·" android:codes="46" android:keyWidth="50%p" />
        <Key android:keyLabel="—" android:codes="45" android:keyWidth="50%p" />
    </Row>
    <Row>
        <Key android:keyLabel="⌫" android:codes="-5" android:keyWidth="25%p" android:isRepeatable="true" />
        <Key android:keyLabel="空格" android:codes="32" android:keyWidth="25%p" />
        <Key android:keyLabel="换行" android:codes="10" android:keyWidth="25%p" />
        <Key android:keyLabel="清除" android:codes="-100" android:keyWidth="25%p" />
    </Row>
</Keyboard>
